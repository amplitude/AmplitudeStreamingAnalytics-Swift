{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "versioning": "prerelease",
      "prerelease": true,
      "bump-minor-pre-major": true,
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "Sources/AmplitudeStreamingAnalytics/StreamingAnalyticsInfo.swift"
        },
        { "type": "generic", "path": "README.md" },
        { "type": "generic", "path": "docs/README.md" },
        { "type": "generic", "path": "docs/configuration.md" },
        { "type": "generic", "path": "docs/events.md" },
        { "type": "generic", "path": "docs/getting-started.md" }
      ]
    }
  }
}
