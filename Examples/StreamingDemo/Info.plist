<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Partial Info.plist, merged with the keys GENERATE_INFOPLIST_FILE produces. It exists
  because Xcode has no INFOPLIST_KEY_* build setting for UIBackgroundModes: setting one
  is accepted silently and never reaches the built plist.
-->
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
